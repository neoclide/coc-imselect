{
  "name": "coc-imselect",
  "version": "0.0.15",
  "description": "Input method extension for coc.nvim on mac.",
  "main": "lib/index.js",
  "publisher": "chemzqm",
  "keywords": [
    "coc.nvim",
    "input"
  ],
  "engines": {
    "coc": "^0.0.80"
  },
  "scripts": {
    "build": "node esbuild.js",
    "postinstall": "./build.sh",
    "prepare": "tsc -p tsconfig.json && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "properties": {
        "imselect.defaultInput": {
          "type": "string",
          "default": "com.apple.keylayout.US",
          "description": "default input source use in normal mode"
        },
        "imselect.enableFloating": {
          "type": "boolean",
          "default": true,
          "description": "Enable floating for input method when possible"
        },
        "imselect.enableStatusItem": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "author": "chemzqm@gmail.com",
  "license": "MIT",
  "devDependencies": {
    "@chemzqm/tsconfig": "^0.0.3",
    "@types/node": "^20.19.43",
    "coc.nvim": "^0.0.83-next.25",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "packageManager": "npm@11.9.0"
}
